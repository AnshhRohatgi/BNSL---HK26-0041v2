# Base URL of the FastAPI backend (no trailing slash). Copy to .env.local for local dev.
# Production (Vercel): set VITE_API_BASE_URL in project settings to your Render URL.
VITE_API_BASE_URL=http://localhost:8000
# Comma-separated list of allowed browser origins (no secrets here).
# Local dev default shown. In production set this to your Vercel URL, e.g. https://greenpulse-ai.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
